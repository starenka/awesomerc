#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["eccodes"]
# ///
"""Fetch current + hourly weather for a fixed point and print normalized JSON.

Output schema (stable across providers):
{
  "provider": "open-meteo",
  "place": "Vinohrady, Praha",
  "updated_at": "14:32",
  "stale": false,
  "stale_since": "14:17",  # only present when stale=true: when this data was fetched
  "current": {"temp_c": 21.4, "precip_prob_pct": 10 | null, "precip_mm": 0.0, "snow_mm": 0.0},
  "hourly": [
    {"time": "14:00", "temp_c": 21.4, "precip_prob_pct": 10 | null, "precip_mm": 0.0, "snow_mm": 0.0},
    ...
  ]
}

snow_mm is scraped from every provider but not meant to be surfaced by the
widget - it's approximate for meteosource (no dedicated field, derived from
whether the reported precip type is a snow variant) and a genuine decoded
grid for aladin (SURFSNOWFALL) and open-meteo (snowfall, cm->mm).

If the active provider's [providers.<name>] section in weather.toml sets a
cache_interval (seconds), a live fetch is skipped entirely and the cached
response is reused as-is (stale=false - it's still considered fresh) as long
as the on-disk cache (.weather-cache/<provider>.json) is younger than that,
by file mtime. --force bypasses this and always attempts a live fetch.

If a live fetch is attempted and fails (network down, provider unreachable,
...) the last successful response for that provider is served from that same
cache with stale=true instead. Only when no cache exists yet does the script
fail with a non-zero exit code.

Subcommands:
  weather location                       show the currently configured location
  weather location "Holešovice, Praha"   resolve a place name and save its
                                          lat/lon (+ the query string) to
                                          weather.toml
  weather provider                       show the currently active provider
  weather provider aladin                set the active provider in weather.toml
  weather --force                        skip cache_interval, always fetch live
"""

import argparse
import bz2
import json
import sys
import time
import tomllib
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

SCRIPT_PATH = Path(__file__).resolve()  # resolve the ~/bin symlink to find sibling files
CONFIG_PATH = SCRIPT_PATH.with_name("weather.toml")
CACHE_DIR = SCRIPT_PATH.with_name(".weather-cache")  # everything cached lives under here
USER_AGENT = "weather-widget/1.0 (personal awesomewm widget; single user)"
HOURS_AHEAD = 12


def http_get_json(url: str, params: dict, headers: dict | None = None) -> dict:
    query = urllib.parse.urlencode(params)
    req = urllib.request.Request(
        f"{url}?{query}", headers={"User-Agent": USER_AGENT, **(headers or {})}
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.load(resp)


def fetch_open_meteo(lat: float, lon: float, tz: str, config: dict) -> dict:
    data = http_get_json(
        "https://api.open-meteo.com/v1/forecast",
        {
            "latitude": lat,
            "longitude": lon,
            "current": "temperature_2m,precipitation",
            "hourly": "temperature_2m,precipitation_probability,precipitation,snowfall",
            "timezone": tz,
            "forecast_days": 2,
        },
    )
    cur = data["current"]
    hourly_raw = data["hourly"]
    times = hourly_raw["time"]
    now = datetime.fromisoformat(cur["time"])
    start = next(
        (i for i, t in enumerate(times) if datetime.fromisoformat(t) >= now), 0
    )

    # snowfall is reported in cm; scraped only (not surfaced by the widget) -
    # keep it in the same mm-ish scale as precip_mm for consistency.
    hourly = [
        {
            "time": times[i][-5:],
            "temp_c": hourly_raw["temperature_2m"][i],
            "precip_prob_pct": hourly_raw["precipitation_probability"][i],
            "precip_mm": hourly_raw["precipitation"][i],
            "snow_mm": round(hourly_raw["snowfall"][i] * 10, 1),
        }
        for i in range(start, min(start + HOURS_AHEAD, len(times)))
    ]

    return {
        "current": {
            "temp_c": cur["temperature_2m"],
            "precip_mm": cur["precipitation"],
            "precip_prob_pct": hourly[0]["precip_prob_pct"] if hourly else None,
            "snow_mm": hourly[0]["snow_mm"] if hourly else 0.0,
        },
        "hourly": hourly,
    }


def fetch_meteosource(lat: float, lon: float, tz: str, config: dict) -> dict:
    key = config.get("providers", {}).get("meteosource", {}).get("api_key")
    if not key:
        raise SystemExit("providers.meteosource.api_key missing from weather.toml")

    data = http_get_json(
        "https://www.meteosource.com/api/v1/free/point",
        {
            "lat": lat,
            "lon": lon,
            "sections": "current,hourly",
            "timezone": tz,
            "language": "en",
            "units": "metric",
            "key": key,
        },
    )
    cur = data["current"]
    hourly_raw = data["hourly"]["data"][:HOURS_AHEAD]

    # Free tier has no precipitation-probability field at all (checked live
    # response + /api/v1/free/openapi.json schema); only paid tiers expose it.
    # No dedicated snow-amount field either - approximated as the full
    # precipitation total whenever its reported type is a snow variant.
    hourly = [
        {
            "time": h["date"][-8:-3],
            "temp_c": h["temperature"],
            "precip_prob_pct": None,
            "precip_mm": h["precipitation"]["total"],
            "snow_mm": h["precipitation"]["total"] if "snow" in (h["precipitation"]["type"] or "") else 0.0,
        }
        for h in hourly_raw
    ]

    return {
        "current": {
            "temp_c": cur["temperature"],
            "precip_mm": cur["precipitation"]["total"],
            "precip_prob_pct": None,
            "snow_mm": cur["precipitation"]["total"] if "snow" in (cur["precipitation"]["type"] or "") else 0.0,
        },
        "hourly": hourly,
    }


# ČHMÚ's own open-data ALADIN model output: real numeric GRIB1 grids at 1km
# resolution over Czechia, 4 runs/day (00/06/12/18 UTC), 72 hourly steps each.
# Deterministic single-run model -> no precipitation-probability field, same
# gap as meteosource. https://opendata.chmi.cz/meteorology/weather/nwp_aladin/
ALADIN_BASE = "https://opendata.chmi.cz/meteorology/weather/nwp_aladin/CZ_1km"
ALADIN_RUN_HOURS = (18, 12, 6, 0)
ALADIN_PUBLISH_DELAY = timedelta(hours=3)  # runs take a while to appear after nominal time


def _aladin_run_candidates(now_utc: datetime):
    """Yield candidate run datetimes (00/06/12/18Z), newest first, ~2 days back."""
    cursor = now_utc - ALADIN_PUBLISH_DELAY
    for _ in range(8):
        hour = max(h for h in ALADIN_RUN_HOURS if h <= cursor.hour)
        run_dt = cursor.replace(hour=hour, minute=0, second=0, microsecond=0)
        yield run_dt
        cursor = run_dt - timedelta(hours=1)


def _aladin_file_meta(headers) -> dict:
    return {
        "etag": headers.get("ETag"),
        "last_modified": headers.get("Last-Modified"),
        "content_length": headers.get("Content-Length"),
    }


def _aladin_ensure_cached(param: str, run_dt: datetime) -> Path:
    """Download+decompress this param/run's grid into .weather-cache/ if not
    already there, or if it has changed on the server since. The run+param is
    only a stable *identifier*, not a guarantee the file itself never gets
    republished/corrected - opendata.chmi.cz is a plain static file server
    that exposes ETag/Last-Modified/Content-Length, so a cheap HEAD request
    checks those against what we last saved instead of trusting local
    existence blindly."""
    run_tag = run_dt.strftime("%Y%m%d%H")
    grb_path = CACHE_DIR / f"aladin-{run_tag}-{param}.grb"
    meta_path = CACHE_DIR / f"aladin-{run_tag}-{param}.meta.json"
    url = f"{ALADIN_BASE}/{run_dt:%H}/ALADCZ1K4opendata_{run_dt:%Y%m%d%H}_{param}.grb.bz2"

    if grb_path.exists() and meta_path.exists():
        try:
            head_req = urllib.request.Request(url, method="HEAD", headers={"User-Agent": USER_AGENT})
            with urllib.request.urlopen(head_req, timeout=10) as resp:
                current_meta = _aladin_file_meta(resp.headers)
            with meta_path.open() as f:
                cached_meta = json.load(f)
            if current_meta == cached_meta:
                return grb_path  # unchanged on the server - skip the full re-download
        except OSError:
            return grb_path  # can't check right now - keep using what we have rather than fail

    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=30) as resp:
        compressed = resp.read()  # raises HTTPError (a run not published yet -> 404) via OSError
        meta = _aladin_file_meta(resp.headers)

    CACHE_DIR.mkdir(exist_ok=True)
    grb_path.write_bytes(bz2.decompress(compressed))
    with meta_path.open("w") as f:
        json.dump(meta, f)

    for old in CACHE_DIR.glob(f"aladin-*-{param}.grb"):
        if old != grb_path:
            old.unlink(missing_ok=True)  # only the latest run is worth keeping on disk
    for old in CACHE_DIR.glob(f"aladin-*-{param}.meta.json"):
        if old != meta_path:
            old.unlink(missing_ok=True)

    return grb_path


def _aladin_series(path: Path, lat: float, lon: float, max_steps: int) -> list[tuple[int, datetime, float]]:
    """Return [(step, valid_time_utc, nearest-gridpoint value), ...] for the first max_steps messages."""
    import eccodes

    out = []
    with path.open("rb") as f:
        while len(out) < max_steps:
            gid = eccodes.codes_grib_new_from_file(f)
            if gid is None:
                break
            try:
                step = eccodes.codes_get(gid, "step")
                vdate = eccodes.codes_get(gid, "validityDate")
                vtime = eccodes.codes_get(gid, "validityTime")
                valid = datetime.strptime(f"{vdate}{vtime:04d}", "%Y%m%d%H%M").replace(tzinfo=timezone.utc)
                value = eccodes.codes_grib_find_nearest(gid, lat, lon)[0].value
                out.append((step, valid, value))
            finally:
                eccodes.codes_release(gid)
    return out


def _de_accumulate(series: list[tuple[int, datetime, float]]) -> dict[int, float]:
    """ALADIN's cumulative-since-run-start fields (precip, snow) -> per-hour amounts."""
    result = {}
    prev = 0.0
    for step, _valid, total in series:
        result[step] = max(0.0, total - prev)
        prev = total
    return result


def fetch_aladin(lat: float, lon: float, tz: str, config: dict) -> dict:
    now_utc = datetime.now(timezone.utc)
    now_hour = now_utc.replace(minute=0, second=0, microsecond=0)

    precip_path = temp_path = snow_path = None
    for run_dt in _aladin_run_candidates(now_utc):
        try:
            precip_path = _aladin_ensure_cached("SURFPREC_TOTAL", run_dt)
            temp_path = _aladin_ensure_cached("CLSTEMPERATURE", run_dt)
            snow_path = _aladin_ensure_cached("SURFSNOWFALL", run_dt)
            break
        except OSError:
            continue  # that run isn't published (yet) - try the previous one
    if precip_path is None:
        raise OSError("no ALADIN run available (checked recent 00/06/12/18Z runs)")

    # Generous buffer: "now" can already be several steps into the run by the
    # time it's published.
    steps_needed = HOURS_AHEAD + 24
    precip_series = _aladin_series(precip_path, lat, lon, steps_needed)  # cumulative mm since run start
    temp_series = _aladin_series(temp_path, lat, lon, steps_needed)  # Kelvin, instantaneous
    snow_series = _aladin_series(snow_path, lat, lon, steps_needed)  # cumulative mm since run start; scraped only

    # temp is an instant reading AT its validity time, so it labels the hour
    # starting there directly (like open-meteo/meteosource). precip/snow are
    # cumulative-since-run-start, so a de-accumulated value at step N covers
    # the hour ENDING at N's validity time, i.e. the hour STARTING at N-1 -
    # so a row labeled with temp step s needs precip/snow from step s+1.
    temp_by_step = {step: value - 273.15 for step, _valid, value in temp_series}
    temp_valid_by_step = {step: valid for step, valid, _value in temp_series}
    hourly_mm = _de_accumulate(precip_series)
    snow_mm_by_step = _de_accumulate(snow_series)

    steps = sorted(temp_by_step)
    # Round "now" down to the hour (like open-meteo's own current.time does)
    # so the in-progress hour is still shown as the first row, not skipped.
    start = next((s for s in steps if temp_valid_by_step[s] >= now_hour), steps[0] if steps else None)
    if start is None:
        raise OSError("ALADIN run had no usable forecast steps")

    hourly = []
    for s in steps:
        if s < start:
            continue
        if len(hourly) >= HOURS_AHEAD:
            break
        local_valid = temp_valid_by_step[s].astimezone(ZoneInfo(tz))
        hourly.append(
            {
                "time": local_valid.strftime("%H:%M"),
                "temp_c": round(temp_by_step[s], 1),
                "precip_prob_pct": None,
                "precip_mm": round(hourly_mm.get(s + 1, 0.0), 2),
                "snow_mm": round(snow_mm_by_step.get(s + 1, 0.0), 2),
            }
        )

    return {
        "current": {
            "temp_c": hourly[0]["temp_c"] if hourly else None,
            "precip_mm": hourly[0]["precip_mm"] if hourly else None,
            "precip_prob_pct": None,
            "snow_mm": hourly[0]["snow_mm"] if hourly else 0.0,
        },
        "hourly": hourly,
    }


PROVIDERS = {
    "open-meteo": fetch_open_meteo,
    "meteosource": fetch_meteosource,
    "aladin": fetch_aladin,
}


def reverse_geocode(lat: float, lon: float, config: dict) -> str:
    key = config.get("geocoding", {}).get("api_key")
    fallback = f"{lat:.4f}, {lon:.4f}"
    if not key:
        return fallback
    try:
        data = http_get_json(
            "https://api.mapy.com/v1/rgeocode",
            {"lon": lon, "lat": lat, "lang": "cs", "apikey": key},
        )
        items = data.get("items") or []
        if not items:
            return fallback
        structure = items[0].get("regionalStructure", [])
        district = next(
            (e["name"] for e in structure if e.get("type") == "regional.municipality_part"),
            None,
        )
        city = next(
            (e["name"] for e in structure if e.get("type") == "regional.municipality"),
            None,
        )
        country = next(
            (e["name"] for e in structure if e.get("type") == "regional.country"),
            None,
        )
        parts = [p for p in (district if district != city else None, city, country) if p]
        return ", ".join(parts) or items[0].get("location") or fallback
    except (OSError, ValueError, KeyError):
        return fallback


def load_config() -> dict:
    if CONFIG_PATH.exists():
        with CONFIG_PATH.open("rb") as f:
            return tomllib.load(f)
    return {}


def _toml_format_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    escaped = str(value).replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def update_config(**updates) -> None:
    """Rewrite matching `key = value` lines in weather.toml in place. Keys may
    be dotted to target a nested section, e.g. update_config(**{"location.lat": 50.1}).
    Preserves comments/ordering; new keys are appended under an existing
    section header if present, otherwise a new section is added at the end.
    tomllib (stdlib) can only read TOML, not write it, hence this hand-rolled
    editor rather than a round-trip parse+dump."""
    lines = CONFIG_PATH.read_text().splitlines() if CONFIG_PATH.exists() else []
    remaining = dict(updates)

    section: tuple[str, ...] = ()
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = tuple(stripped[1:-1].split("."))
            continue
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key = stripped.split("=", 1)[0].strip()
        dotted = ".".join((*section, key))
        if dotted in remaining:
            lines[i] = f"{key} = {_toml_format_value(remaining.pop(dotted))}"

    by_section: dict[tuple[str, ...], list[tuple[str, object]]] = {}
    for dotted, value in remaining.items():
        *sect, key = dotted.split(".")
        by_section.setdefault(tuple(sect), []).append((key, value))

    for sect, kvs in list(by_section.items()):
        if not sect:
            continue
        header = "[" + ".".join(sect) + "]"
        for i, line in enumerate(lines):
            if line.strip() == header:
                j = i + 1
                while j < len(lines) and not lines[j].strip().startswith("["):
                    j += 1
                lines[j:j] = [f"{k} = {_toml_format_value(v)}" for k, v in kvs]
                del by_section[sect]
                break

    for sect, kvs in by_section.items():
        if lines and lines[-1].strip() != "":
            lines.append("")
        if sect:
            lines.append("[" + ".".join(sect) + "]")
        lines.extend(f"{k} = {_toml_format_value(v)}" for k, v in kvs)

    CONFIG_PATH.write_text("\n".join(lines) + "\n")
    CONFIG_PATH.chmod(0o600)  # holds API keys


def cmd_location(query: str | None, config: dict) -> int:
    location = config.get("location", {})
    if query is None:
        lat, lon = location.get("lat"), location.get("lon")
        if lat is None or lon is None:
            print("no location set (see: weather location <query>)", file=sys.stderr)
            return 1
        saved_query = location.get("query")
        print(f"{saved_query} (lat={lat} lon={lon})" if saved_query else f"lat={lat} lon={lon}")
        return 0

    key = config.get("geocoding", {}).get("api_key")
    if not key:
        print("geocoding.api_key missing from weather.toml", file=sys.stderr)
        return 1
    try:
        data = http_get_json(
            "https://api.mapy.com/v1/geocode",
            {"query": query, "lang": "cs", "limit": 1, "apikey": key},
        )
    except (OSError, ValueError) as exc:
        print(f"geocode request failed: {exc}", file=sys.stderr)
        return 1
    items = data.get("items") or []
    if not items:
        print(f"no results for {query!r}", file=sys.stderr)
        return 1
    item = items[0]
    lat, lon = item["position"]["lat"], item["position"]["lon"]
    update_config(**{"location.query": query, "location.lat": lat, "location.lon": lon})
    print(f"{query!r} -> {item.get('name', '')} ({item.get('location', '')}); saved lat={lat} lon={lon}")
    return 0


def cmd_provider(name: str | None, config: dict) -> int:
    if name is None:
        print(config.get("provider", "open-meteo"))
        return 0
    update_config(provider=name)
    print(f"provider set to {name!r}")
    return 0


def cache_path_for(provider: str) -> Path:
    return CACHE_DIR / f"{provider}.json"


def load_cache(provider: str) -> dict | None:
    path = cache_path_for(provider)
    try:
        with path.open() as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return None


def save_cache(provider: str, place: str, weather: dict, fetched_at: str) -> None:
    path = cache_path_for(provider)
    try:
        CACHE_DIR.mkdir(exist_ok=True)
        with path.open("w") as f:
            json.dump({"place": place, "weather": weather, "fetched_at": fetched_at}, f)
    except OSError:
        pass


def cache_is_fresh(provider: str, max_age_seconds: float | None) -> bool:
    if not max_age_seconds:
        return False
    try:
        age = time.time() - cache_path_for(provider).stat().st_mtime
    except OSError:
        return False
    return age < max_age_seconds


def main() -> int:
    config = load_config()
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--force", action="store_true", help="ignore cache_interval, always fetch live"
    )
    subparsers = parser.add_subparsers(dest="command")
    location_parser = subparsers.add_parser(
        "location", help="show, or resolve+save, the configured location"
    )
    location_parser.add_argument(
        "query", nargs="?", default=None, help="e.g. 'Holešovice, Praha'; omit to show the current one"
    )
    provider_parser = subparsers.add_parser(
        "provider", help="show, or set, the active provider"
    )
    provider_parser.add_argument("name", nargs="?", default=None, choices=PROVIDERS)

    args = parser.parse_args()

    if args.command == "location":
        return cmd_location(args.query, config)
    if args.command == "provider":
        return cmd_provider(args.name, config)

    location = config.get("location", {})
    lat, lon = location.get("lat"), location.get("lon")
    if lat is None or lon is None:
        parser.error("location.lat/lon not set in weather.toml (see: weather location)")

    provider = config.get("provider", "open-meteo")
    tz = location.get("timezone", "Europe/Prague")
    now = datetime.now(ZoneInfo(tz)).strftime("%H:%M")

    cache_interval = config.get("providers", {}).get(provider, {}).get("cache_interval")
    if not args.force and cache_is_fresh(provider, cache_interval):
        cached = load_cache(provider)
        if cached is not None:
            result = {
                "provider": provider,
                "place": cached["place"],
                "updated_at": cached["fetched_at"],
                "stale": False,
                **cached["weather"],
            }
            json.dump(result, sys.stdout)
            return 0

    stale = False
    stale_since = None
    try:
        weather = PROVIDERS[provider](lat, lon, tz, config)
    except (OSError, ValueError, KeyError) as exc:
        cached = load_cache(provider)
        if cached is None:
            print(f"fetch failed and no cache available: {exc}", file=sys.stderr)
            return 1
        weather = cached["weather"]
        place = cached["place"]
        stale = True
        stale_since = cached["fetched_at"]
    else:
        place = reverse_geocode(lat, lon, config)
        save_cache(provider, place, weather, now)

    result = {
        "provider": provider,
        "place": place,
        "updated_at": now,
        "stale": stale,
        **weather,
    }
    if stale:
        result["stale_since"] = stale_since
    json.dump(result, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
