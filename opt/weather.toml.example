# Copy this file to weather.toml (untracked, chmod 600 - holds API keys) and
# fill in your own values. See opt/weather --help for the full schema notes.

# Active provider - swap by changing this one line. Each provider's own
# details (api key, rate limit, ...) live in its [providers.<name>] section
# below.
provider = "open-meteo"

[location]
# Run `weather location "your address"` to resolve+save query/lat/lon
# automatically instead of editing these by hand.
query = "Holešovice, Praha"
lat = 50.10064
lon = 14.4355
timezone = "Europe/Prague"

[geocoding]
# Get a free key at https://developer.mapy.com/account/ - used for both
# forward (weather location "query") and reverse geocoding.
api_key = "your-mapy-com-api-key"
rate_limit_per_second = 100

[providers.open-meteo]
# No API key needed. Free/non-commercial use has a generous rate limit.
rate_limit_per_day = 10000
# Don't re-fetch more often than this (seconds) - reuse the cached response
# instead. No real need to poll faster than the widget itself ticks.
cache_interval = 300

[providers.meteosource]
# Free tier has no precipitation-probability field at all. Get a free key at
# https://www.meteosource.com/.
api_key = "your-meteosource-api-key"
rate_limit_per_day = 400
# 400/day allows one call every ~216s at most; 300s keeps a safety margin
# (288/day) even if something (right-click, hover catch-up, ...) fetches
# more often than the periodic timer.
cache_interval = 300

[providers.aladin]
# No API key; open data. The GRIB downloads themselves are already bounded
# to ~4/day by the run-based disk cache, but every call still does a HEAD
# request per parameter (to check the cached file is still current) plus a
# fresh decode - cache_interval avoids repeating that work within the window.
cache_interval = 300
